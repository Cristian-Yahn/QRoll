# Copiá este archivo como ".env" (en esta misma carpeta) y completá los valores.
# El archivo ".env" NO se sube a Git.

PORT=3000

# Ruta del archivo SQLite, relativa a la carpeta backend/
DB_PATH=database/qroll.db

# Clave para firmar las sesiones. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Opcional. Por defecto: America/Argentina/Buenos_Aires
ZONA_HORARIA=America/Argentina/Buenos_Aires

# "production" activa la cookie "secure" (solo funciona con HTTPS).
# En desarrollo dejalo en "development".
NODE_ENV=development

# ---------- Correo (recuperar contraseña y aviso de intentos fallidos) ----------
# Si SMTP_HOST / SMTP_USER / SMTP_PASS quedan vacíos y NODE_ENV no es "production",
# los correos NO se envían: se muestran en la terminal del servidor (sirve para probar).
#
# Con Gmail: la cuenta necesita la verificación en dos pasos y una "contraseña de
# aplicación" (16 letras, se crea en myaccount.google.com/apppasswords).
# La contraseña normal de Gmail NO funciona. Usá una contraseña de aplicación propia
# de QRoll (así, si se filtra, la revocás sin afectar otros proyectos).
SMTP_HOST=smtp.gmail.com
# 465 = SSL directo; 587 = STARTTLS. Cualquiera de los dos sirve con Gmail.
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-letras
EMAIL_FROM=QRoll <tu-cuenta@gmail.com>

# Dirección pública de QRoll: es la que llevan los enlaces de los correos.
# Local: http://localhost:3000 — con túnel (probar desde el celular): la URL https del túnel.
# En producción: https://tu-dominio
BASE_URL=http://localhost:3000
